# LocalServe Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local mongod)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/localserve?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# Frontend Client URL
CLIENT_URL=http://localhost:5173
